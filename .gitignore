*.playground/

# macOS
.DS_Store
._*

# Internal thinking docs — kept locally, not committed.
# Forward-facing docs live in README.md at the root.
docs/

# WebEyeTrack upstream clone — local inspection only.
# Re-clone with: git clone --depth=1 https://github.com/RedForestAI/WebEyeTrack.git
Tools/Conversion/WebEyeTrack-upstream/

# Python venvs for conversion scripts
.venv/
venv/

# Evaluation data (large, not for redistribution)
Data/Evaluation/External/
Data/Evaluation/*/
!Data/Evaluation/.gitkeep

# Converted model artifacts (large)
Sources/MacGaze/Gaze/*.mlmodelc
*.mlpackage

# MediaPipe native library (48MB, not redistributable via git)
Frameworks/libmediapipe.dylib
Frameworks/face_landmarker.task

# Get via:
#   cp ../macgaze/Tools/Conversion/.venv/lib/python3.13/site-packages/mediapipe/tasks/c/libmediapipe.dylib Frameworks/
#   cp ../macgaze/Tools/Conversion/WebEyeTrack-upstream/python/webeyetrack/model_weights/face_landmarker_v2_with_blendshapes.task Frameworks/
